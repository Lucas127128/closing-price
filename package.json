{
  "name": "closing-price",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bunx -b vite dev",
    "build": "vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js",
    "sync": "svelte-kit sync || echo ''",
    "check": "bun sync && svelte-check --tsconfig ./tsconfig.json && bun lint",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check-build": "wrangler deploy --dry-run --outdir output-check && bundle-analyzer output-check",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/svelte": "^1.32.0",
    "@tanstack/svelte-query": "^6.1.38",
    "bcryptjs": "^3.0.3",
    "cap-widget": "^0.1.57",
    "capjs-core": "^0.1.2",
    "comptime": "^0.1.0",
    "daisyui": "^5.7.17",
    "hucre": "^1.1.0",
    "p-memoize": "^8.0.0",
    "quick-lru": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill-lite": "^0.4.2",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@sveltejs/adapter-cloudflare": "8.0.0-next.6",
    "@sveltejs/kit": "3.0.0-next.23",
    "@tailwindcss/vite": "^4.3.3",
    "bundle-analyzer": "^0.0.6",
    "eslint-plugin-svelte": "^3.23.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "packageManager": "bun@1.4.0"
}
